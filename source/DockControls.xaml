<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <SolidColorBrush x:Key="DockControlAccent">#0A88FF</SolidColorBrush>
  <SolidColorBrush x:Key="DockControlPaper">#F4F4F6</SolidColorBrush>
  <SolidColorBrush x:Key="DockControlMuted">#A1A1A7</SolidColorBrush>
  <SolidColorBrush x:Key="DockControlRow">#262626</SolidColorBrush>

  <Style x:Key="DockCalendarNav" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#3A3A3C"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="#3A3A3C"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DockCalendarDay" TargetType="p:CalendarDayButton">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="p:CalendarDayButton">
          <Border x:Name="Day" Background="{StaticResource DockControlRow}" CornerRadius="7" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#69696D"/><Setter TargetName="Day" Property="Background" Value="Transparent"/></Trigger>
            <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource DockControlAccent}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="#38383B"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource DockControlAccent}"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#C3E1FF"/></Trigger>
            <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value=".3"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DockCalendarPeriod" TargetType="p:CalendarButton">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="p:CalendarButton">
          <Border x:Name="Period" Background="{StaticResource DockControlRow}" CornerRadius="7" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#69696D"/></Trigger>
            <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Period" Property="Background" Value="{DynamicResource DockControlAccent}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Period" Property="BorderBrush" Value="#7C7C86"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Period" Property="BorderBrush" Value="#C3E1FF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DockCalendarItem" TargetType="p:CalendarItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="p:CalendarItem">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}" Foreground="{StaticResource DockControlMuted}" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </ControlTemplate.Resources>
          <Border x:Name="PART_Root" Background="#212122" BorderBrush="#3A3A3D" BorderThickness="1"
                  CornerRadius="14" Padding="8">
            <Grid Width="232">
              <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="206"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions>
              <Button x:Name="PART_PreviousButton" Content="‹" Style="{StaticResource DockCalendarNav}"/>
              <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource DockCalendarNav}"/>
              <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Style="{StaticResource DockCalendarNav}"/>
              <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                  <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="23"/><RowDefinition/><RowDefinition/><RowDefinition/>
                  <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
              </Grid>
              <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              </Grid>
              <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#66000000"
                      IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DockDateCalendar" TargetType="Calendar">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DockCalendarDay}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource DockCalendarPeriod}"/>
    <Setter Property="CalendarItemStyle" Value="{StaticResource DockCalendarItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <StackPanel x:Name="PART_Root"><p:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DockDateField" TargetType="DatePicker">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Background" Value="{StaticResource DockControlRow}"/>
    <Setter Property="BorderBrush" Value="#383838"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CalendarStyle" Value="{StaticResource DockDateCalendar}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Grid x:Name="PART_Root">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="12"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
              <p:DatePickerTextBox x:Name="PART_TextBox" Background="Transparent"
                                   Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                                   BorderThickness="0" Padding="9,0,0,0" VerticalContentAlignment="Center">
                <p:DatePickerTextBox.Template>
                  <ControlTemplate TargetType="p:DatePickerTextBox">
                    <Grid Margin="{TemplateBinding Padding}">
                      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                      <ContentControl x:Name="PART_Watermark" Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=DatePicker}}"
                                      VerticalAlignment="Center" Foreground="{StaticResource DockControlMuted}"
                                      IsHitTestVisible="False" Focusable="False" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Text" Value=""><Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </p:DatePickerTextBox.Template>
              </p:DatePickerTextBox>
              <Button x:Name="PART_Button" Grid.Column="1" Margin="1,2,3,2" Style="{StaticResource DockCalendarNav}"
                      AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                <Path Width="13" Height="13" Stroke="#A1A1A7" StrokeThickness="1.2" Stretch="Uniform"
                      Data="M 1,3 H 12 V 12 H 1 Z M 1,6 H 12 M 4,1 V 4 M 9,1 V 4"/>
              </Button>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                   VerticalOffset="5" AllowsTransparency="True" StaysOpen="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#6995CA"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#6995CA"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Флажок задач: скруглённый тёмный квадрат, при выборе заливается акцентом с галочкой; наведение, фокус, нажатие и недоступность -->
  <Style x:Key="DockCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="7" BorderThickness="1.5" BorderBrush="#6A6A6F"
                      Background="#1F1F20" VerticalAlignment="Center">
                <Path x:Name="Tick" Width="11" Height="9" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M 1,5 L 4,8 L 10,1" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="#2A2A2B"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="#A1A1A7"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Background" Value="#333335"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource DockControlAccent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DockControlAccent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#6995CA"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Тонкая тёмная полоса прокрутки: без стрелок, скруглённый ползунок -->
  <Style x:Key="DockScrollPage" TargetType="p:RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="p:RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DockScrollThumb" TargetType="p:Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="p:Thumb">
          <Border x:Name="Bar" Margin="2" CornerRadius="4" Background="#56565B"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#7A7A80"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource DockControlAccent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <p:Track x:Name="PART_Track" IsDirectionReversed="True">
              <p:Track.DecreaseRepeatButton><p:RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource DockScrollPage}"/></p:Track.DecreaseRepeatButton>
              <p:Track.Thumb><p:Thumb Style="{StaticResource DockScrollThumb}"/></p:Track.Thumb>
              <p:Track.IncreaseRepeatButton><p:RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource DockScrollPage}"/></p:Track.IncreaseRepeatButton>
            </p:Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <p:Track x:Name="PART_Track">
                  <p:Track.DecreaseRepeatButton><p:RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource DockScrollPage}"/></p:Track.DecreaseRepeatButton>
                  <p:Track.Thumb><p:Thumb Style="{StaticResource DockScrollThumb}"/></p:Track.Thumb>
                  <p:Track.IncreaseRepeatButton><p:RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource DockScrollPage}"/></p:Track.IncreaseRepeatButton>
                </p:Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Выпадающий список (города мировых часов): та же рамка, что у поля даты; список в скруглённом тёмном окне -->
  <Style x:Key="DockComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Frame" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="#303033"/>
              <Setter Property="Foreground" Value="{DynamicResource DockControlAccent}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#3A3A3C"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DockComboBox" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Background" Value="{StaticResource DockControlRow}"/>
    <Setter Property="BorderBrush" Value="#383838"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DockComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="12"/>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid Background="Transparent">
                    <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="10" Height="6"
                          Stretch="Uniform" Stroke="#A1A1A7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Data="M 0,0 L 5,5 L 10,0"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="#F4F4F6"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" VerticalOffset="5"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, ElementName=PART_Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="#1F1F20" BorderBrush="#383838" BorderThickness="1" CornerRadius="12" Padding="4">
                <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#5A5A5E"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#6995CA"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#6995CA"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Поле пароля интеграций: та же рамка, что у обычных полей ввода -->
  <Style x:Key="DockPasswordBox" TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="Background" Value="{StaticResource DockControlRow}"/>
    <Setter Property="BorderBrush" Value="#383838"/>
    <Setter Property="CaretBrush" Value="{StaticResource DockControlPaper}"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="12">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#5A5A5E"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#6995CA"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
